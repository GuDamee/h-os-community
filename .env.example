# Optional. Read from the environment or from this file (copy to .env; never commit .env).
# Set it locally and, on DigitalOcean, as an app env var. Without it the desk still
# explains each match with a deterministic Italian sentence from the tags and the score.
# The key is sent only to the Gemini API for that “perché”. It never unlocks extra data.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hosted Gemma model on the Gemini API. Override if your key serves a different id.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Frozen clock for the Hack Day demo so "tomorrow morning" stays tomorrow morning.
DEMO_NOW=2026-10-24T18:40:00+02:00

# Where approvals live. Delete this file to reset the bacheca.
HOS_DB=var/hos.sqlite

# Curated demo data, or a folder produced by data/generate.py
HOS_DATA_DIR=data
